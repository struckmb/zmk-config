#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// Deutsche Layout-Übersetzungen importieren
#include "de_aliases.h"

// Layer Definitionen
#define NOTED 0
#define QWERTZ 1
#define SYMB 2
#define NAVI 3
#define FUNC 4

/ {
    behaviors {
        // Home Row Mods Anpassung (HRM)
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Layer Tap für Daumen / Außenbahnen
        lt_b: layer_taps {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    // Caps Word (Sorgt dafür, dass Umlaute und ß das CapsWord nicht abbrechen)
    caps_word: caps_word {
        compatible = "zmk,behavior-caps-word";
        #binding-cells = <0>;
        continue-list = <DE_A DE_B DE_C DE_D DE_E DE_F DE_G DE_H DE_I DE_J DE_K DE_L DE_M DE_N DE_O DE_P DE_Q DE_R DE_S DE_T DE_U DE_V DE_W DE_X DE_Y DE_Z DE_ADIA DE_ODIA DE_UDIA DE_MINS DE_UNDS DE_SS MINUS NUMBER_1 NUMBER_2 NUMBER_3 NUMBER_4 NUMBER_5 NUMBER_6 NUMBER_7 NUMBER_8 NUMBER_9 NUMBER_0 BACKSPACE DELETE>;
    };

    combos {
        compatible = "zmk,combos";

        // Globaler Daumen-Combo (ESC Daumen + TAB Daumen) -> Öffnet FUNC Layer
        combo_thumb_func {
            timeout-ms = <50>;
            key-positions = <37 38>; 
            bindings = <&mo FUNC>;
        };

        // NOTED Layer Combos
        combo_j_noted {
            timeout-ms = <40>;
            key-positions = <9 10>; // DE_L + DE_F
            bindings = <&kp J>;
            layers = <NOTED>;
        };
        combo_sz_noted {
            timeout-ms = <40>;
            key-positions = <21 22>; // HRM R + HRM H
            bindings = <&kp DE_SS>;
            layers = <NOTED>;
        };

        // QWERTZ Layer Combos
        combo_ue_qwertz {
            timeout-ms = <40>;
            key-positions = <9 10>; // DE_O + DE_P
            bindings = <&kp DE_UDIA>;
            layers = <QWERTZ>;
        };
        combo_ae_qwertz {
            timeout-ms = <40>;
            key-positions = <21 22>; // HRM L + HRM ODIA
            bindings = <&kp DE_ADIA>;
            layers = <QWERTZ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        noted_layer {
            bindings = <
&none          &kp DE_Z      &kp DE_Y      &kp DE_U      &kp DE_A      &kp DE_Q        &kp DE_P        &kp DE_B      &kp DE_M      &kp DE_L      &kp DE_F      &none
&mo SYMB       &hm LGUI DE_C &hm LALT DE_S &hm LSHIFT DE_I &hm LCTRL DE_E &kp DE_O      &kp DE_D        &hm RCTRL DE_T &hm RSHIFT DE_N &hm LALT DE_R &hm RGUI DE_H &mo SYMB
&none          &kp DE_V      &kp DE_X      &kp DE_UDIA   &kp DE_ADIA   &kp DE_ODIA     &kp DE_W        &kp DE_G      &kp DE_COMM   &kp DE_DOT    &kp DE_K      &none
                                           &lt_b NAVI ESC &kp LGUI     &lt_b NAVI TAB  &lt_b NAVI TAB  &kp SPACE     &none
            >;
        };

        qwertz_layer {
            bindings = <
&none          &kp DE_Q      &kp DE_W      &kp DE_E      &kp DE_R      &kp DE_T        &kp DE_Z        &kp DE_U      &kp DE_I      &kp DE_O      &kp DE_P      &none
&mo SYMB       &hm LGUI DE_A &hm LALT DE_S &hm LSHIFT DE_D &hm LCTRL DE_F &kp DE_G      &kp DE_H        &hm RCTRL DE_J &hm RSHIFT DE_K &hm LALT DE_L &hm RGUI DE_ODIA &mo SYMB
&none          &kp DE_Y      &kp DE_X      &kp DE_C      &kp DE_V      &kp DE_B        &kp DE_N        &kp DE_M      &kp DE_COMM   &kp DE_DOT    &kp DE_SS     &none
                                           &lt_b NAVI ESC &kp LGUI     &lt_b NAVI TAB  &lt_b NAVI TAB  &kp SPACE     &none
            >;
        };

        symb_layer {
            bindings = <
&trans         &kp DE_ELLP   &kp DE_UNDS   &kp DE_LBRC   &kp DE_RBRC   &kp DE_CIRC     &kp DE_EXLM     &kp DE_LABK   &kp DE_RABK   &kp DE_EQL    &kp DE_AMPR   &trans
&trans         &kp DE_BSLS   &kp DE_SLSH   &kp DE_LCBR   &kp DE_RCBR   &kp DE_ASTR     &kp DE_QUES     &kp DE_LPRN   &kp DE_RPRN   &kp DE_MINS   &kp DE_COLN   &trans
&trans         &kp DE_HASH   &kp DE_DLR    &kp DE_PIPE   &kp DE_TILD   &kp DE_GRV      &kp DE_PLUS     &kp DE_PERC   &kp DE_DQUO   &kp DE_QUOT   &kp DE_SCLN   &trans
                                           &trans        &kp G(DE_CIRC) &trans         &kp DE_AT       &trans        &trans
            >;
        };

        navi_layer {
            bindings = <
&trans         &kp PG_UP     &kp BSPC      &kp UP        &kp DEL       &kp PG_DN       &kp DE_MINS     &kp N7        &kp N8        &kp N9        &kp DE_SLSH   &trans
&trans         &kp HOME      &kp LEFT      &kp DOWN      &kp RIGHT     &kp END         &kp DE_PLUS     &hm RCTRL N4  &hm RSHIFT N5 &hm LALT N6   &hm RGUI DE_ASTR &trans
&trans         &kp LC(LSFT(Z)) &kp LC(LSFT(TAB)) &caps_word &kp LC(TAB) &kp LC(Z)       &kp DE_COLN     &kp N1        &kp N2        &kp N3        &kp DE_EQL    &trans
                                           &trans        &trans        &trans          &kp N0          &tog NAVI     &trans
            >;
        };

        func_layer {
            bindings = <
&trans         &kp F1        &kp F2        &kp F3        &kp F4        &kp INS         &kp DE_LDAQ     &kp DE_LSAQ   &kp DE_RSAQ   &kp DE_RDAQ   &kp DE_ACUT   &trans
&trans         &kp F5        &kp F6        &kp F7        &kp F8        &kp K_APP       &kp DE_DEG      &kp DE_MDOT   &kp DE_SLQU   &kp DE_LSQU   &kp DE_RSQU   &trans
&trans         &kp F9        &kp F10       &kp F11       &kp F12       &kp PSCRN       &kp DE_NDSH     &kp DE_MDSH   &kp DE_DLQU   &kp DE_LDQU   &kp DE_RDQU   &trans
                                           &tog QWERTZ   &trans        &trans          &kp DE_SLNG     &tog NAVI     &trans
            >;
        };
    };
};

